GITHUB_OWNER=your-github-name
GITHUB_REPO=your-private-data-repository
GITHUB_BRANCH=main
GITHUB_TOKEN=
# Generate separate random secrets. Never commit .env or paste token into HTML.
VAULT_PASSWORD=
SESSION_SECRET=
# Exact public HTTPS URL of the app/server; no trailing slash.
PUBLIC_ORIGIN=https://your-domain.example
PORT=3000
