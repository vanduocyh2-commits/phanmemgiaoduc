# Hosted portal: PostgreSQL, account sessions and common file storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional PostgreSQL connection instead of Supabase REST adapter.
DATABASE_URL=
ADMIN_PASSWORD=
SESSION_SECRET=
PORT=3000
NODE_ENV=development
# Optional separate legacy GitHub file-vault server (node server.mjs).
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_TOKEN=
VAULT_PASSWORD=
PUBLIC_ORIGIN=

# Optional AI essay grading (keep the key only on the VPS; never expose it to the browser).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Authenticated PDF converter on the school service; set the same private key on both services.
DOCUMENT_CONVERTER_URL=https://thayduoc-nha-truong.onrender.com/internal/convert-document
DOCUMENT_CONVERTER_KEY=
